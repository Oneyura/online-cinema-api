# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=cinema_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET=cinema-storage
MINIO_SECURE=False
MINIO_REGION=us-east-1

# AWS Compatibility
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_REGION=us-east-1

# Application settings
APP_NAME=Online Cinema API
DEBUG=True
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
API_DOCS_URL=/api/docs
API_REDOC_URL=/api/redoc

# JWT
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_USE_TLS=True

# Admin interfaces auth
MAILHOG_USER=your_mailhog_user
MAILHOG_PASSWORD=your_mailhog_password
FLOWER_USER=your_flower_user
FLOWER_PASSWORD=your_flower_password

COOKIE=False
