# PostgreSQL
POSTGRES_USER=<your_postgres_user>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=<your_postgres_db>
POSTGRES_HOST=<your_postgres_host>
POSTGRES_PORT=5432

# Redis
REDIS_HOST=<your_redis_host>
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=<your_minio_user>
MINIO_ROOT_PASSWORD=<your_minio_password>
MINIO_HOST=<your_minio_host>
MINIO_PORT=9000
MINIO_BUCKET=<your_minio_bucket>
MINIO_SECURE=True
MINIO_REGION=us-east-1

# AWS Compatibility
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_REGION=us-east-1

# Application
APP_NAME=Online Cinema API
DEBUG=False
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
API_DOCS_URL=/api/docs
API_REDOC_URL=/api/redoc

# Domain settings
DOMAIN=<your_domain>
ALLOWED_HOSTS=localhost,127.0.0.1,<your_domain>,stripe.com

# CORS
CORS_ORIGINS=["https://<your_domain>"]
CORS_HEADERS=["*"]

# JWT settings
JWT_SECRET_KEY=<your_jwt_secret_key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://<your_redis_host>:6379/0
CELERY_RESULT_BACKEND=redis://<your_redis_host>:6379/0

# Email
MAIL_USERNAME=<your_email>
MAIL_PASSWORD=<your_email_password>
MAIL_FROM=<your_email>
MAIL_PORT=1025
MAIL_SERVER=<your_smtp_server>
MAIL_FROM_NAME=Cinema Service
MAIL_TLS=True

# Admin interfaces auth
MAILHOG_USER=<your_mailhog_user>
MAILHOG_PASSWORD=<your_mailhog_password>
FLOWER_USER=${MAILHOG_USER}
FLOWER_PASSWORD=${MAILHOG_PASSWORD}

# Gunicorn settings
WORKERS_PER_CORE=1
MAX_WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker

# Ports configuration
POSTGRES_SERVER_PORT=5432
NGINX_PORT=80
NGINX_SSL_PORT=443
MINIO_CONSOLE_PORT=9001

# Logging
LOG_LEVEL=INFO

# Additional security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Cookie
COOKIE=True