[flake8]
max-line-length = 120
extend-ignore = E203, E266, E501, W503, F403, F405, E402, E731, C901, W504, E722, B001, F841
exclude = 
    .git,
    __pycache__,
    docs/,
    migrations/,
    .env,
    .venv,
    env/,
    venv/,
    src/schemas/,
    src/database/models/,
    tests/
max-complexity = 15 